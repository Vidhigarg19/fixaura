# --- Client (Vite) environment variables ---
# Copy this file to .env.local and fill in your Supabase project values.
# Find these in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# --- Server-side secrets (DO NOT add as VITE_ variables) ---
# Server-side Supabase Function secret names: GEMINI_API_KEY, GEMINI_MODEL.
# Setup: docs/analysis-env.md. Never add provider secrets as VITE_ variables.
