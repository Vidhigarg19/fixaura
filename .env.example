# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real values and never paste them into docs or chat.
# Full reference: README.md ("Environment variables") and docs/ARCHITECTURE.md.

# --- Client (Vite) environment variables: these are bundled into the browser build ---
# Find these in the Supabase dashboard: Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional, development only. "true" lets a dev build load built-in test data through
# ?fixture=<name> in the address bar. Anything else (or a production build) keeps it off.
# Keep it "false" unless you are working on the fixture screens.
VITE_ENABLE_FIXTURES=false

# --- Server-side secrets (DO NOT add as VITE_ variables) ---
# These are Supabase Edge Function secrets, set with `supabase secrets set NAME=value`.
# Names only, no values here: GEMINI_API_KEY, GEMINI_MODEL, ANALYSIS_TIMEOUT_MS,
# ANALYSIS_USER_PER_MINUTE_LIMIT, ANALYSIS_USER_DAILY_LIMIT, ANALYSIS_GLOBAL_DAILY_LIMIT.
# Setup and defaults: docs/analysis-env.md. Never add provider secrets as VITE_ variables.
